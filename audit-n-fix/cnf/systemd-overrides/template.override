# All list or boolean-type directives default to the strictest value whilst trying to maintain filesystem structure
#
# All list-type directives use space-delimited values unless stated otherwise
#
# Prepend a tilde ~ to the start of a list (like the ones in the Capabilities section)
# 	to make it a blacklist. Though, generally whitelists are preferred
# Declaring a directive with exclusively a tilde ~ means "blacklist nothing"
# All directives which are related to hiding, mounting, or binding paths for only the service imply PrivateMounts=true
# Ditto plus depend upon an API VFS will imply MountAPIVFS=true





[Service]
#
# Capabilities
#
# 1. UID 0 services can never get caps not specified here
# In this usage, the service gets no capabilities,
#	even if the service runs as root
# 2. Non-UID 0 services obtain specified caps w/o access to UID 0
# Options:
#	CAP_AUDIT_CONTROL CAP_AUDIT_READ CAP_AUDIT_WRITE
#	CAP_BLOCK_SUSPEND CAP_BPF CAP_CHECKPOINT_RESTORE
#	CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH
#	CAP_FOWNER CAP_FSETID CAP_IPC_LOCK CAP_IPC_OWNER
#	CAP_KILL CAP_LEASE CAP_LINUX_IMMUTABLE CAP_MAC_ADMIN
#	CAP_MAC_OVERRIDE CAP_MKNOD CAP_NET_ADMIN
#	CAP_NET_BIND_SERVICE CAP_NET_BROADCAST CAP_NET_RAW
#	CAP_PERFMON CAP_SETGID CAP_SETFCAP
#	CAP_SETPCAP CAP_SETUID CAP_SYS_ADMIN
#	CAP_SYS_BOOT CAP_SYS_CHROOT CAP_SYS_DEMAND
#	CAP_SYS_NICE CAP_SYS_PACCT CAP_SYS_PTRACE
#	CAP_SYS_RAWIO CAP_SYS_RESOURCE CAP_SYS_TIME
#	CAP_SYS_TTY_CONFIG CAP_SYSLOG CAP_WAKE_ALARM
# 3. Mostly self-explanatory; takes a boolean
#	Implicit of explicitly an unset CapabilityBoundingSet and
# 	inability to access files in ways initially unable to
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=true





#
# Filesystem
#
# Functionally identical to chroot.
# Takes a path to a directory that's ideally a BTRFS subvolume
#	on the same FS as /var/lib/systemd/ephemeral-trees/
RootDirectory=
#
# 1. Ditto but exclusively for block device nodes and loopback files
# Mutually-exclusive to RootDirectory
# Takes a path to a file
# 2. Mount options for mounting RootImage.
RootImage=
RootImageOptions=
#
# Makes an ephemeral copy of the RootDirectory/RootImage
#	for the service to live on.
RootEphemeral=true
#
# The following are bound to the service's namespace:
#	/proc /sys /dev /run
# Has no effect with RootDirectory/RootImage directives
# Takes a boolean
MountAPIVFS=true
#
# Makes journald (sockets) and /dev/log available to the service's namespace
BindLogSockets=true
#
# All self-explanatory; but notably this does not take priority over the Protect*= directives
#	unlike the Bind*= directives
ReadWritePaths=
ReadOnlyPaths=
TemporaryFileSystem=
InaccessiblePaths=
ExecPaths=
NoExecPaths=
#
# 1. Changes the visibility of /proc and its contents
# noaccess	- /proc can be enumerated, but not accessed
# invisible	- /proc cannot be enumerated nor accessed
# ptracable - /proc PIDs not ptracable by the service user cannot be enumerated
# default	- No change
ProtectProc=invisible
ProtectSystem=strict
ProtectHome=tmpfs
PrivateTmp=disconnected
PrivateDevices=true
PrivateIPC=true
PrivateUsers=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=strict
#
# 1. A list of paths that should be made fully to the service's namespace
# Prefix a hyphen - to the path to make it not strictly required for the service to attempt starting
# Will not work in directories in the namespace which are marked inaccessible or otherwise immutable
# 2. Ditto but read only
BindPaths=
BindReadOnlyPaths=
#
# Self-explanatory
UMask=077
#
# If the service coredumps, decides which coredumps to keep
# Options:
#	private-anonymous shared-anonymous private-file-backed
#	shared-file-backed elf-headers private-huge
#	shared-huge private-dax shared-dax
#	all (of the above)
#	default (private-anonymous shared-anonymous elf-headers private-huge)
# 	(unset) (none of the above)
CoredumpFilter=





#
# Resource Management
#
Nice=
LimitCPU=
LimitFSIZE=
LimitSTACK=
LimitCORE=
LimitNPROC=
LimitMEMLOCK=
LimitLOCKS=
LimitSIGPENDING=
LimitMSGQUEUE=
LimitNICE=
LimitRTPRIO=
RestrictRealtime=true
LimitRTTIME=
OOMScoreAdjust=1000





#
# Networking
#
PrivateNetwork=true
RemoveIPC=true
#
# Values:
#	AF_UNIX AF_LOCAL AF_INET AF_AX25 AF_IPX
#	AF_APPLETALK AF_NETROM AF_BRIDGE AF_ATMPVC AF_X25
#	AF_INET6 AF_ROSE AF_NETROM AF_DECnet AF_NETBEUI
#	AF_SECURITY AF_KEY AF_NETLINK AF_PACKET AF_ECONET
#	AF_ATMSVC AF_RDS AF_SMC AF_XDP AF_IRDA
#	AF_PPPOX AF_WANPIPE AF_LLC AF_PACKET AF_IB
#	AF_MPLS AF_CAN AF_TIPC AF_BLUETOOTH AF_IUCV
#	AF_VSOCK AF_SMC AF_RXRPC AF_ISDN AF_PHONET
#	AF_IEEE802154 AF_CAIF AF_ALG AF_VSOCK AF_IUCV
#	AF_SMC AF_KCM AF_QIPCRTR AF_SMC AF_RDS
#	AF_IUCV AF_VSOCK AF_XDP AF_MCTP
# Allows local comms and IPv4/6 traffic.
# Looking to disable remote connectiosn completely? Use PrivateNetwork=true
# Looking to disable IPC? Use RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6





#
# Execution
#
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
#
# See here for preset values: https://man7.org/linux/man-pages/man5/systemd.exec.5.html#:~:text=predefined%20system%20call%20sets
SystemCallFilter=@system-service
